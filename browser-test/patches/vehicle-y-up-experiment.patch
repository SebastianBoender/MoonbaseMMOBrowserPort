+// Restricted to Moonbase's authored Y-up rigid-body vehicle; other movies
+// retain their existing emulator path while the native comparisons run.
+fn is_moonbase_vehicle_scene(state: &HavokPhysicsState) -> bool {
+    state.gravity[1].abs() > state.gravity[2].abs()
+        && state.rigid_bodies.iter().any(|b| b.name.as_str().eq_ignore_ascii_case("Car"))
+        && state.rigid_bodies.iter().any(|b| b.name.as_str().eq_ignore_ascii_case("Spring"))
+}
+
+// The original Xtra uses the COM for a zero dashpot anchor, but model-local
+// coordinates for a nonzero one. Verified with the native Car/Spring traces.
+fn dashpot_anchor(rb: &crate::player::cast_member::HavokRigidBody, point: V3, native: bool) -> V3 {
+    let local = if native && point == [0.0; 3] { rb.center_of_mass } else { point };
+    body_transform_point(rb, local)
+}
